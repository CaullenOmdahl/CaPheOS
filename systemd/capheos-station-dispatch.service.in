[Unit]
Description=@NAME@ dispatcher — self-paced loop that wakes agents who own open work (tick from cadence.json)
After=@SVC@.service

[Service]
Type=simple
WorkingDirectory=@ROOT@
# the company's own slice (company/tools/lib/memory.js sliceOf), outside app.slice: systemd-oomd's pressure kill is off
# there (memory.js apply writes its drop-ins), so nothing here can make oomd end the owner's apps or another company's
Slice=@SLICE@
# the company's own temp dir, not the host's /tmp (RAM on most hosts); scripts/setup-station.sh
Environment=TMPDIR=@ROOT@/.starnet-data/tmp
ExecStartPre=/bin/mkdir -p -m 700 @ROOT@/.starnet-data/tmp
ExecStart=/usr/bin/env node @NODEFLAGS@ @ROOT@/company/tools/dispatcher-loop.js
Restart=always
# memory: limits and heap in the drop-in company/tools/memory.js apply writes. Under memory pressure systemd-oomd (where
# it runs) may end this unit; Restart= brings it back, and the kernel ends it before the station (200 against 100).
MemoryAccounting=yes
OOMScoreAdjust=200
ManagedOOMMemoryPressure=kill
ManagedOOMMemoryPressureLimit=80%
RestartSec=30
# SIGTERM to the loop only: it lets a running tick finish (60 s grace), then exits 0
KillMode=mixed
TimeoutStopSec=120

[Install]
WantedBy=default.target
