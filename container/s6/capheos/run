#!/command/with-contenv sh
# CaPheOS is one process: the console HTTP face and the runtime are the same Node program
# (docs/BACKEND.md §3, decision 1). s6 supervises it; nothing else is a service.
set -eu

if [ ! -f /app/server/index.js ]; then
  echo "capheos: server/index.js is missing — the backend rewrite (P1) has not landed yet" >&2
  echo "capheos: see container/README.md and docs/BACKEND.md §8" >&2
  # Hold the container open instead of crash-looping: the health check reports unhealthy, and the
  # reason is in the log once. This branch disappears when server/index.js exists (P1).
  exec sleep infinity
fi

# the company's temp dir on the data volume (TMPDIR in capheos.yml), swept by company/tools/tmp-sweep.js
if [ -n "${TMPDIR:-}" ] && [ "${TMPDIR#/data/}" != "$TMPDIR" ]; then install -d -m 700 -o capheos -g capheos "$TMPDIR"; fi

exec s6-setuidgid capheos node /app/server/index.js
