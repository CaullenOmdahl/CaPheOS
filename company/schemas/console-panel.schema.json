{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capheos:console-panel",
  "title": "CaPheOS console panel (company/console/panels/<id>/panel.json)",
  "description": "A company-made panel the owner console shows. Source ids, limits and screens are checked against company/console/sources.json by company/tools/console-panel.js validate; this schema checks the shape. Guide: docs/CONSOLE-PANELS.md.",
  "type": "object",
  "required": [
    "version",
    "id",
    "title",
    "owner",
    "why",
    "placement",
    "sources",
    "view"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,39}$",
      "description": "Must equal the folder name."
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "maxLength": 280
    },
    "owner": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "description": "The accountable seat: a function (ceo, people, tools, risk, floor, finance) or a seat id/name from company/tools/loops.json. A function survives a re-hire; prefer it."
    },
    "why": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400,
      "description": "Why the owner would look at this often. Shown on the panel's info popover."
    },
    "placement": {
      "$ref": "#/$defs/placement"
    },
    "refresh": {
      "type": "integer",
      "minimum": 30,
      "maximum": 86400,
      "description": "Seconds between refreshes. Default 300."
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 4,
      "propertyNames": {
        "pattern": "^[a-z][a-zA-Z0-9_]{0,31}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "view": {
      "$ref": "#/$defs/view"
    },
    "actions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "placement": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "area"
          ],
          "additionalProperties": false,
          "properties": {
            "area": {
              "const": "today"
            },
            "order": {
              "$ref": "#/$defs/order"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "area",
            "screen"
          ],
          "additionalProperties": false,
          "properties": {
            "area": {
              "const": "side"
            },
            "screen": {
              "enum": [
                "today",
                "comms",
                "crew",
                "work",
                "hiring",
                "automate",
                "usage",
                "floor",
                "abilities"
              ]
            },
            "order": {
              "$ref": "#/$defs/order"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "area",
            "nav"
          ],
          "additionalProperties": false,
          "properties": {
            "area": {
              "const": "screen"
            },
            "nav": {
              "type": "string",
              "minLength": 2,
              "maxLength": 24,
              "description": "Label under the Company nav group."
            },
            "order": {
              "$ref": "#/$defs/order"
            }
          }
        }
      ]
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99,
      "description": "Order among company panels in the same placement only; built-in content always comes first."
    },
    "dotPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_$-]+(\\.[A-Za-z0-9_$-]+)*$",
      "maxLength": 120
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_]{0,31}$"
    },
    "format": {
      "enum": [
        "text",
        "number",
        "integer",
        "percent",
        "money",
        "date",
        "datetime",
        "relative",
        "duration",
        "bool"
      ]
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "glob"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "file"
            },
            "glob": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "description": "Relative to the project root, under an allowed root, e.g. company/work/desk/positions.json"
            },
            "pick": {
              "enum": [
                "single",
                "latest",
                "all"
              ],
              "description": "single (default): exactly one match; latest: newest by mtime; all: [{file, data}]"
            },
            "select": {
              "$ref": "#/$defs/dotPath"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "tool"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,47}$",
              "description": "An id from sources.json tool"
            },
            "select": {
              "$ref": "#/$defs/dotPath"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "station"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,47}$",
              "description": "An id from sources.json station"
            },
            "select": {
              "$ref": "#/$defs/dotPath"
            }
          }
        }
      ]
    },
    "stat": {
      "type": "object",
      "required": [
        "source",
        "value",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/sourceRef"
        },
        "value": {
          "$ref": "#/$defs/dotPath",
          "description": "Dot path into the source data; 'length' counts an array."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "format": {
          "$ref": "#/$defs/format"
        },
        "unit": {
          "type": "string",
          "maxLength": 12
        },
        "goodWhen": {
          "enum": [
            "up",
            "down",
            "zero",
            "nonzero"
          ]
        }
      }
    },
    "column": {
      "type": "object",
      "required": [
        "key",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/dotPath"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "format": {
          "$ref": "#/$defs/format"
        },
        "width": {
          "enum": [
            "narrow",
            "normal",
            "wide"
          ]
        },
        "flag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "maxLength": 60,
          "description": "A boolean key in the row; when true the cell shows the warn tone."
        }
      }
    },
    "view": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "source",
            "value",
            "label"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "stat"
            },
            "source": {
              "$ref": "#/$defs/sourceRef"
            },
            "value": {
              "$ref": "#/$defs/dotPath",
              "description": "Dot path into the source data; 'length' counts an array."
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "format": {
              "$ref": "#/$defs/format"
            },
            "unit": {
              "type": "string",
              "maxLength": 12
            },
            "goodWhen": {
              "enum": [
                "up",
                "down",
                "zero",
                "nonzero"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "stat-row"
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "$ref": "#/$defs/stat"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "source",
            "columns"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "table"
            },
            "source": {
              "$ref": "#/$defs/sourceRef"
            },
            "rows": {
              "$ref": "#/$defs/dotPath",
              "description": "Dot path to the row array; omit when the data is the array."
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "$ref": "#/$defs/column"
              }
            },
            "sort": {
              "type": "object",
              "required": [
                "key"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "$ref": "#/$defs/dotPath"
                },
                "dir": {
                  "enum": [
                    "asc",
                    "desc"
                  ]
                }
              }
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "empty": {
              "type": "string",
              "maxLength": 120
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "source",
            "title"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "list"
            },
            "source": {
              "$ref": "#/$defs/sourceRef"
            },
            "items": {
              "$ref": "#/$defs/dotPath"
            },
            "title": {
              "$ref": "#/$defs/dotPath"
            },
            "subtitle": {
              "$ref": "#/$defs/dotPath"
            },
            "badge": {
              "$ref": "#/$defs/dotPath"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "empty": {
              "type": "string",
              "maxLength": 120
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "source",
            "at",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "timeline"
            },
            "source": {
              "$ref": "#/$defs/sourceRef"
            },
            "items": {
              "$ref": "#/$defs/dotPath"
            },
            "at": {
              "$ref": "#/$defs/dotPath"
            },
            "text": {
              "$ref": "#/$defs/dotPath"
            },
            "who": {
              "$ref": "#/$defs/dotPath"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "empty": {
              "type": "string",
              "maxLength": 120
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "source",
            "chart",
            "x",
            "series"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "chart"
            },
            "source": {
              "$ref": "#/$defs/sourceRef"
            },
            "chart": {
              "enum": [
                "line",
                "bar"
              ]
            },
            "rows": {
              "$ref": "#/$defs/dotPath"
            },
            "x": {
              "type": "object",
              "required": [
                "key"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "$ref": "#/$defs/dotPath"
                },
                "label": {
                  "type": "string",
                  "maxLength": 32
                },
                "format": {
                  "$ref": "#/$defs/format"
                }
              }
            },
            "series": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "label"
                ],
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "$ref": "#/$defs/dotPath"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  },
                  "format": {
                    "$ref": "#/$defs/format"
                  }
                }
              }
            },
            "y": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 32
                },
                "zero": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "markdown"
            },
            "source": {
              "$ref": "#/$defs/sourceRef"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "html"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "custom"
            },
            "html": {
              "const": "view.html"
            },
            "height": {
              "type": "integer",
              "minimum": 120,
              "maximum": 1200
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/sourceRef"
              },
              "description": "Sources passed in; default all."
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "label",
        "kind",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,31}$"
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "kind": {
          "enum": [
            "handoff",
            "ask-ceo",
            "owner-question-draft"
          ]
        },
        "to": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "handoff only: a function or a seat id/name"
        },
        "scope": {
          "enum": [
            "panel",
            "row"
          ],
          "description": "row = offered on each row/item and may use {{row.<key>}}"
        },
        "text": {
          "type": "string",
          "minLength": 5,
          "maxLength": 600,
          "description": "Template; placeholders {{row.<key>}} and {{panel.title}} only"
        }
      }
    }
  }
}
