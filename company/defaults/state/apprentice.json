  "allowKinds": [1, 2, 5],
  "allowDepths": ["lookup", "simple"]
 },
 "study": {
  "hourLocal": 3,
  "quietHours": 3,
  "everyHours": 24,
  "kinds": [1, 2, 5],
  "depths": ["lookup", "simple"],
  "repeat": 2,
