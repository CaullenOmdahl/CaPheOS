index 0000000..fa2cefd
--- /dev/null
+++ b/sidecar/delegate-allow.js
@@ -0,0 +1,83 @@
+/* sidecar/delegate-allow.js — THE DELEGATION ALLOWLIST: which ROUTINE lead may hand which item's pieces to which workers
+   NOW (CA PHE DIGITAL, company/patches/0018).
+
+   WHY. team.dispatch fans out real autonomous runs that spend. A browser-commanded lead and the owner's own DM keep it (the
+   Commander is there); a scheduled routine run had no say from anyone. A company that wants a routine lead to delegate
+   decides, per tick, exactly which lead, for which item, to which workers on its own team, how many at once and for how
+   long each (company/tools/lib/delegate-allow.js), and the station follows that list.
+
+   THE FILE. The absolute path named by env STARNET_DELEGATE_ALLOW, read on each request (cached by path + mtime + size):
+     { "v": 1, "at": <epoch ms written>, "by": "dispatcher",
+       "leads": { "<lead agentId>": { "items": ["<item id>"], "workers": ["<agentId>"], "maxWorkers": 3, "workerTimeoutMin": 20,
+                                      "models": { "<agentId>": [ { "provider": "...", "model": "..." } ] } } } }
+
+   THE RULE (fail closed).
+     - env unset or empty, not absolute, file missing, unreadable, not JSON, not v:1, no leads object, "at" older than
+       MAX_AGE_MS (30 minutes) or more than a minute in the future -> no lead is listed: no routine run gets team.dispatch.
+     - a lead entry needs at least one worker id, maxWorkers >= 1 and workerTimeoutMin >= 1, else it is not listed.
+     - leadOf(agentId) -> null | { items, workers, maxWorkers, workerTimeoutMin, workerTimeoutMs, models, itemId }
+
+     makeDelegateAllow({ envName?, env?, fs?, now }) -> { leadOf(agentId), read() -> { ok, list } | { ok:false } }
+       now: the host's clock (index.js injects it); without one nobody is listed
+     parseList(text) / entryOf(list, agentId, nowMs) -> the same answers over a parsed list (the tests). */
+'use strict';
+const nodeFs = require('fs');
+
+const MAX_AGE_MS = 30 * 60 * 1000;
+const ENV_NAME = 'STARNET_DELEGATE_ALLOW';
+const ID_RE = /^[A-Za-z0-9_-]{1,40}$/;
+const ITEM_RE = /^[A-Za-z0-9_.:#\/-]{1,160}$/;
+
+function parseList(text) {
+  let j; try { j = JSON.parse(text); } catch (_) { return null; }
+  if (!j || typeof j !== 'object' || j.v !== 1) return null;
+  const at = Number(j.at);
+  if (!Number.isFinite(at) || at <= 0) return null;
+  if (!j.leads || typeof j.leads !== 'object' || Array.isArray(j.leads)) return null;
+  const leads = Object.create(null);
+  for (const id of Object.keys(j.leads)) {
+    const e = j.leads[id]; if (!ID_RE.test(id) || !e || typeof e !== 'object') continue;
+    const workers = (Array.isArray(e.workers) ? e.workers : []).map(String).filter(w => ID_RE.test(w) && w !== id);
+    const items = (Array.isArray(e.items) ? e.items : []).map(String).filter(i => ITEM_RE.test(i));
+    const maxWorkers = Math.floor(Number(e.maxWorkers)), mins = Number(e.workerTimeoutMin);
+    if (!workers.length || !(maxWorkers >= 1) || !(mins >= 1) || !items.length) continue;
+    const models = Object.create(null);
+    for (const w of workers) models[w] = (Array.isArray(e.models && e.models[w]) ? e.models[w] : []).filter(r => r && typeof r.provider === 'string' && typeof r.model === 'string')
+      .map(r => ({ provider: r.provider.trim().toLowerCase(), model: r.model.trim() }));
+    leads[id] = { items, workers, maxWorkers: Math.min(maxWorkers, workers.length), workerTimeoutMin: mins, workerTimeoutMs: Math.round(mins * 60000), models, itemId: items[0] };
+  }
+  return { at, by: String(j.by || ''), leads };
+}
+function entryOf(list, agentId, nowMs) {
+  const now = Number(nowMs);   // the caller's clock (lint-determinism: no ambient clock here)
+  if (!list || !Number.isFinite(now) || !(now - list.at <= MAX_AGE_MS) || list.at - now > 60 * 1000) return null;
+  const id = String(agentId || '');
+  return Object.prototype.hasOwnProperty.call(list.leads, id) ? list.leads[id] : null;
+}
+
+function makeDelegateAllow(opts) {
+  const o = opts || {};
+  const fs = o.fs || nodeFs;
+  const env = o.env || process.env;
+  const envName = o.envName || ENV_NAME;
+  const now = typeof o.now === 'function' ? o.now : () => NaN;   // no clock injected: nobody is listed (fail closed)
+  let cache = null;   // { file, mtimeMs, size, list }
+  function read() {
+    const file = String(env[envName] || '').trim();
+    if (!file || !require('path').isAbsolute(file)) return { ok: false };
+    let st; try { st = fs.statSync(file); } catch (_) { cache = null; return { ok: false }; }
+    if (!st.isFile()) return { ok: false };
+    if (cache && cache.file === file && cache.mtimeMs === st.mtimeMs && cache.size === st.size) return cache.list ? { ok: true, list: cache.list } : { ok: false };
+    let text; try { text = fs.readFileSync(file, 'utf8'); } catch (_) { cache = null; return { ok: false }; }
+    const list = text.length <= 4 * 1024 * 1024 ? parseList(text) : null;
+    cache = { file, mtimeMs: st.mtimeMs, size: st.size, list };
+    return list ? { ok: true, list } : { ok: false };
+  }
+  function leadOf(agentId) {
+    const r = read();
+    return r.ok ? entryOf(r.list, agentId, now()) : null;
+  }
+  return { leadOf, read };
+}
+
+module.exports = { makeDelegateAllow, parseList, entryOf, MAX_AGE_MS, ENV_NAME };
