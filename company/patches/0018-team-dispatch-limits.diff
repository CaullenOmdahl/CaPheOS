+}
+const roster = new Map([['ben', { system: 'B', name: 'BEN', model: 'm' }], ['cat', { system: 'C', name: 'CAT', model: 'm' }], ['dan', { system: 'D', name: 'DAN', model: 'm' }], ['eve', { system: 'E', name: 'EVE', model: 'm' }]]);
+const gateOf = o => Object.assign({ items: ['to-kwa.md#abc123'], itemId: 'to-kwa.md#abc123', workers: ['ben', 'cat', 'dan'], maxWorkers: 3, workerTimeoutMin: 20, workerTimeoutMs: 20 * 60000, models: { ben: [{ provider: 'anthropic', model: 'claude-sonnet-5-5' }], cat: [], dan: [] } }, o || {});
+const rowsOf = out => JSON.parse(out.content);
