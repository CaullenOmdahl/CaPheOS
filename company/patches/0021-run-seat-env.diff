# 0021 — a run's shell knows which seat and which run it belongs to (STARNET_AGENT_ID, STARNET_RUN_ID).
# Status: APPLIED by setup-station.sh.
# Why (2026-11-20, fr-0085 from the sandbox crew: Halima Cisse found it, Kwame Asante built it): since wave 3 the
# external gate checks an in-run call as the station's own STARNET_AGENT_ID and never trusts --agent from a run, but the
# station never put that variable in a run's shell, so every in-run check read as agent `unknown` and only `agent: any`
# clearance rows matched. inbox.js, accountable.js, approvals.js, merge-gate.js, premerge-check.js, profile.js,
# consult.js, routing.js, departments.js and lib/owner-card.js read the same variable.
# What it changes: environment.js sets both last in a task child's env (an inherited value cannot shadow them; a run id
# that is not a plain id is left out), for foreground and background commands; shell.js passes ctx.runId to both.
# The terminal (terminal_start) PTY path is not changed.
# Apply: git -C starnet apply --3way company/patches/0021-run-seat-env.diff, then restart the station when idle.
--- a/sidecar/environment.js
+++ b/sidecar/environment.js
@@ -327,6 +327,16 @@
       if (!serviceEnvFn) return childEnv;
       try { return mergeServiceEnv(childEnv, serviceEnvFn(surface)); } catch (_) { return childEnv; }
     }
+    /* WHO THE RUN IS. The station knows which seat and which run issued a command; the command's own shell does not,
+       and company/tools/external-gate.js, inbox.js, merge-gate.js and others read STARNET_AGENT_ID / STARNET_RUN_ID to
+       find out. Set last, so nothing inherited can shadow them. agentId has passed safeAgentId; a run id that is not a
+       plain id is left out rather than passed on. */
+    const RUN_ID_RE = /^[A-Za-z0-9_.:-]{1,80}$/;
+    function withRun(env, agentId, runId) {
+      const out = Object.assign({}, env, { STARNET_AGENT_ID: agentId });
+      if (runId && RUN_ID_RE.test(String(runId))) out.STARNET_RUN_ID = String(runId);
+      return out;
+    }
     const sessions = new Map();
 
     function workspaceRoot(agentId) {
