+// HEADLESS (CaPheOS patch 0010): the owner's UI is the CaPheOS console, which drives this engine through /api. With
+// STARNET_HEADLESS=1 the station page and its assets are not served at all, so no stale page can push its own crew or
+// answer agent calls; every /api route is unchanged.
+const HEADLESS = process.env.STARNET_HEADLESS === '1';
 async function serveStatic(req, res) {
+  if (HEADLESS) {
+    // an /api path that reached here is simply not a route (wrong method or unknown): say that, not "headless"
+    if (/^\/api\//.test(String(req.url || ''))) { res.writeHead(404, { 'Content-Type': 'application/json' }); return res.end(JSON.stringify({ error: 'no such API route for ' + req.method + ' ' + String(req.url).split('?')[0] })); }
+    res.writeHead(410, { 'Content-Type': 'text/plain; charset=utf-8', 'Cache-Control': 'no-store' });
+    return res.end('This station runs headless. Use the CaPheOS console (scripts/console.sh); the engine API is unchanged.\n');
+  }
