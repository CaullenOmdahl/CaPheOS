+  'use strict';
+  var root = (typeof window !== 'undefined') ? window : null;
+  if (!root) return;
+  var on = false;
+  try { on = new URLSearchParams(String(root.location && root.location.search || '')).get('viewer') === '1'; } catch (_) { on = false; }
+  try { Object.defineProperty(root, '__STARNET_VIEWER__', { value: on, writable: false, configurable: false, enumerable: false }); } catch (_) { /* already fixed by an earlier copy: it cannot change now either way */ }
+  if (root.__STARNET_VIEWER__ !== true) return;
+
+  var CODE = 'viewer_readonly';
+  var guards = [];
+  var refused = [];   // what this page tried to send (method + path), newest last, for the capture tool's report
+  var refusedCount = 0;
+  var refusedBy = {};   // "kind METHOD path" -> count, every kind ever refused (a busy boot cannot push one out)
+  var refusedKeys = 0, refusedOverflow = 0;
+  function note(kind, method, url) {
+    refusedCount++;
+    var p = '';
+    try { var u = new URL(String((url && url.url) || url || ''), root.location.href); p = (u.origin === root.location.origin ? '' : u.origin) + u.pathname; } catch (_) { p = String(url || '').slice(0, 80); }
+    var k = kind + ' ' + String(method || '').toUpperCase() + ' ' + p;
+    refused.push(k);
+    if (refused.length > 80) refused.shift();
+    if (Object.prototype.hasOwnProperty.call(refusedBy, k)) refusedBy[k]++;
+    else if (refusedKeys < 1000) { refusedBy[k] = 1; refusedKeys++; }
+    else refusedOverflow++;
+  }
