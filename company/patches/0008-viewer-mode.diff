+    return new Response(JSON.stringify({ ok: false, error: 'this page is a read-only viewer', code: CODE }),
+      { status: 403, headers: { 'Content-Type': 'application/json', 'X-StarNet-Code': CODE } });
+  }
+
+  // 1. fetch — harness.js wraps this guarded fetch with the token logic, so every /api call passes through it
+  try {
+    if (typeof root.fetch === 'function') {
+      var rawFetch = root.fetch.bind(root);
+      root.fetch = function (input, init) {
