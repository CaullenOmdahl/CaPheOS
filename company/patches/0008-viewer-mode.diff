+      guards.push('fetch');
+    }
+  } catch (_) {}
+  // 2. XMLHttpRequest (the page uses none today; a future caller is held to the same rule)
+  try {
+    var XP = root.XMLHttpRequest && root.XMLHttpRequest.prototype;
