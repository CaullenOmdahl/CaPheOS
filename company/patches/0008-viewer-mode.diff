+    var ES = root.EventSource;
+    if (typeof ES === 'function') {
+      var Feed = function (url, cfg) {
+        var u = String(url || '');
+        try { var x = new URL(u, root.location.href); if (x.pathname === '/api/channels/events') { x.searchParams.set('viewer', '1'); u = x.href; } } catch (_) {}
