+/* node test/served-model.test.js — THE RUN ROW SAYS WHICH MODEL SERVED IT (CA PHE DIGITAL, company/patches/0016).
+
+   `model` on a run row is the model the run ASKED for. The Claude CLI accepts a Fable request on an account without
+   Fable and serves another model, so the asked-for name is a claim, not a fact. Each adapter now reads the model its
+   provider's own response names (the CLI's stream-json, an Anthropic message_start, an OpenAI-compatible chunk) and
+   puts it on its usage / done events as servedModel; the loop keeps the last one (and every distinct one when it
+   changed mid-run); the run row carries servedModel / servedModels. A response that names no model adds nothing. */
+'use strict';
+const A = require('./_assert.js');
+const { EventEmitter } = require('events');
+const { makeClaudeCliProvider, _internals } = require('../sidecar/providers/claude-cli.js');
+const { makeAnthropicProvider } = require('../sidecar/providers/anthropic.js');
