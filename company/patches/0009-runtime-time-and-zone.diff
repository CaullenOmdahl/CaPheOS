# 0009 — agents get the time and zone, not just the date (CaPheOS).
# Status: APPLIED by setup-station.sh
# Why: agents are bad at inferring elapsed time; the per-run [RUNTIME] line now states date, HH:MM, IANA zone and UTC offset at
# run start, and tells the agent to run `date` for the time now. Zone = the station process TZ, which setup-station.sh sets from
# company.json timezone. Also updates the two StarNet tests that pinned the old wording.
# Apply: git -C starnet apply --3way ../company/patches/0009-runtime-time-and-zone.diff   Revert: same with -R
diff --git a/sidecar/runtimeinfo.js b/sidecar/runtimeinfo.js
index bf0b95b2..410cdb8d 100644
--- a/sidecar/runtimeinfo.js
+++ b/sidecar/runtimeinfo.js
@@ -32,12 +32,22 @@
     return out;
   }
 
-  // "Today is Wednesday, September 30, 2026 (station clock; trust it over your own sense of the date)." or '' —
+  // "Run started Wednesday, September 30, 2026 14:05 America/Chicago (UTC-05:00) (station clock; …)." or '' —
   // kept short: it rides every run's system prompt, which has a hard byte budget (test/payload.budget.test.js)
   function todayLine(now) {
     const t = Number(now);
     if (!Number.isFinite(t) || t <= 0) return '';
-    try { return 'Today is ' + new Date(t).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) + ' (station clock; trust it over your own sense of the date).'; } catch (_) { return ''; }
+    // Date, time and zone at the start of this run (CaPheOS patch 0009): agents are bad at inferring elapsed time, so
+    // they get the clock as data, plus how to read it again mid-run. Zone = the station's TZ (set from company.json).
+    try {
+      const d = new Date(t);
+      const date = d.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
+      const time = d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false });
+      let tz = ''; try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (_) {}
+      const off = -d.getTimezoneOffset(); const sign = off >= 0 ? '+' : '-'; const a = Math.abs(off);
+      const utc = 'UTC' + sign + String(Math.floor(a / 60)).padStart(2, '0') + ':' + String(a % 60).padStart(2, '0');
+      return 'Run started ' + date + ' ' + time + ' ' + (tz ? tz + ' (' + utc + ')' : utc) + ' (station clock; trust it over your own sense of time; run `date` for the time now).';
+    } catch (_) { return ''; }
   }
 
