# 0012 — two runs of one agent may write in two DIFFERENT project folders at once (CaPheOS Sprint lanes).
# Status: APPLIED by setup-station.sh
# Why: StarNet admits a second run of an agent (sidecar/concurrency.js counts distinct agents) and leases one run per
# ROUTINE, so a Sprint lane is its own run in its own folder (docs/TEMPO.md "Parallel lanes"). But every workspace-mutating
# tool call (fs.write/append/edit/patch, every shell.* and verify.* call, terminal.start/write: index.js mutatesWorkspace)
# took sidecar/workspace-lease.js keyed on the agent id ALONE, held until the run ends: the second run's first shell call
# waited 45 s (WORKSPACE_LEASE_WAIT_MS) and failed "workspace busy", so a lane spent tokens and did nothing.
# What it changes: the lease key is agentId + the run's resolved project folder (o.projectRoot: a routine's workdir as the
# station canonicalised it, or a blessed /api/run projectRoot; realpath'd once per run so acquire and release always use
# the same key). Runs in different folders no longer wait on each other; two runs in the SAME folder, and runs with no
# folder, share one key exactly as before. Agent-wide operations (checkpoint restore, POST /api/autonomy/write, delete)
# still exclude every run of the agent: they take the agent's own key and refuse "workspace busy" while any folder lease of
# that agent is held, and a folder write that starts during one answers busy (retryable). GET /api/version gains
# `capabilities: ["workspace-lease-per-folder"]`, the marker company/tools/lanes.js probes before it starts a lane.
# Test: test/e2e.workspace-lease-per-folder.test.js boots the real sidecar and drives two runs of one agent (different
# folders: B writes while A is live; same folder: B is refused busy; the autonomy write is refused while A holds a folder;
# the version marker). It fails 4 of 14 without this patch. test/e2e.workspace-lease.test.js, workspace-lease.test.js and
# agent-lifecycle.test.js are unchanged and pass.
# Known gap: the checkpoint index (WORKSPACES/.checkpoints/<agentId>/index.json) stays per agent; each folder already has
# its own shadow git dir (roots/<scope>), and checkpoints are fail-open, so two lanes snapshotting at the same instant can
# lose one index entry, never corrupt a run.
# Apply: git -C starnet apply --3way ../company/patches/0012-workspace-lease-per-workdir.diff, then restart the station.
# Revert: git -C starnet apply -R ../company/patches/0012-workspace-lease-per-workdir.diff
diff --git a/sidecar/index.js b/sidecar/index.js
index 7c046ead..0fa74620 100644
--- a/sidecar/index.js
+++ b/sidecar/index.js
@@ -11555,8 +11555,50 @@ const workspaceLease = makeWorkspaceLease(Object.assign(
   { now: () => Date.now() },
   (_leaseWaitMs >= 0 && isFinite(_leaseWaitMs)) ? { waitMs: Math.floor(_leaseWaitMs) } : {}
 ));
+// patch 0012 (CaPheOS lanes): a run with a project folder (projectRoot: a routine's workdir, or a blessed /api/run root)
+// leases agent + that folder (realpath'd once per run), not the agent alone, so two runs of one agent in two different
+// folders do not wait on each other; two runs in the SAME folder, and runs with no folder, share a key exactly as before.
+// Agent-wide operations (checkpoint restore, the autonomy write, delete) still exclude every run of the agent: they take
+// the agent's own key and also refuse while any folder lease of it is held; a folder write during one answers busy.
+const WORKSPACE_LEASE_CAPABILITY = 'workspace-lease-per-folder';   // GET /api/version capabilities (CaPheOS probes it)
+const runLeaseKeys = new Map();      // runId -> the lease key this run uses (one value for its acquire and its release)
+const folderLeaseRuns = new Map();   // agentId -> Map(runId -> since) of folder leases held now
+const agentWideOps = new Set();      // agentIds with an agent-wide operation in progress
+function workspaceLeaseKey(agentId, projectRoot) {
+  const raw = String(projectRoot || '').trim();
+  if (!raw) return String(agentId);
+  let root = path.resolve(raw); try { root = fs.realpathSync(root); } catch (_) {}
+  return String(agentId) + '\u0000' + (path.sep === '\\' ? root.toLowerCase() : root);
+}
+async function acquireRunLease(agentId, runId, projectRoot) {
+  let k = runLeaseKeys.get(runId);
+  if (!k) { k = workspaceLeaseKey(agentId, projectRoot); runLeaseKeys.set(runId, k); }
+  if (k === String(agentId)) return workspaceLease.acquire(k, runId);
+  const held = folderLeaseRuns.get(String(agentId));
+  if (agentWideOps.has(String(agentId)) && !(held && held.has(runId))) return { ok: false, timedOut: true, holder: workspaceLease.holderOf(agentId) };
+  const got = await workspaceLease.acquire(k, runId);
+  if (got.ok && agentWideOps.has(String(agentId)) && !(held && held.has(runId))) { workspaceLease.release(k, runId); return { ok: false, timedOut: true, holder: workspaceLease.holderOf(agentId) }; }   // one began while this waited
+  if (got.ok) { const m = folderLeaseRuns.get(String(agentId)) || new Map(); if (!m.has(runId)) m.set(runId, Date.now()); folderLeaseRuns.set(String(agentId), m); }
+  return got;
+}
+function releaseRunLease(agentId, runId) {
+  const k = runLeaseKeys.get(runId) || String(agentId); runLeaseKeys.delete(runId);
+  const m = folderLeaseRuns.get(String(agentId)); if (m) { m.delete(runId); if (!m.size) folderLeaseRuns.delete(String(agentId)); }
+  workspaceLease.release(k, runId);
+}
+const agentWideLease = {
+  async acquire(agentId, op) {
+    const got = await workspaceLease.acquire(agentId, op);
+    if (!got.ok) return got;
+    const m = folderLeaseRuns.get(String(agentId));
+    if (m && m.size) { workspaceLease.release(agentId, op); const [runId, since] = m.entries().next().value; return { ok: false, timedOut: true, holder: { runId, since } }; }
+    agentWideOps.add(String(agentId));
+    return got;
+  },
+  release(agentId, op) { if ((workspaceLease.holderOf(agentId) || {}).runId === String(op)) agentWideOps.delete(String(agentId)); workspaceLease.release(agentId, op); }
+};
 const agentLifecycle = makeAgentLifecycle({
-  workspaceLease,
+  workspaceLease: agentWideLease,
   isActive: (agentId) => concurrencyGate.inFlight(agentId) > 0
 });
 // NAME IS LOAD-BEARING: a second module-scope `function runGit(root, args, timeoutMs)` (the night-shift /
@@ -24853,7 +24895,7 @@ async function runOnceCore(o) {
     // (bounded, visible as its in-flight agent.tool_call), then fails truthfully naming the holder. Re-entrant:
     // the holding run's later tools never re-wait.
