-      const lease = await workspaceLease.acquire(agentId, runId);
+      const lease = await acquireRunLease(agentId, runId, o.projectRoot);   // patch 0012: one writer per agent AND folder
       if (!lease.ok) {
         let holderNote = 'another live run of this agent holds the workspace.';
         try {
@@ -26800,7 +26842,7 @@ async function runOnceCore(o) {
     if (runComputer?.close) { try { await runComputer.close(); } catch (_) { failNote('computer.run.close', 'Native run cleanup failed'); } }
     computerRuns.delete(runComputer);
     concurrencyGate.leave(agentId);   // release the admission slot on EVERY exit (normal, early-return, or throw)
-    workspaceLease.release(agentId, runId);   // free (or withdraw the queued wait for) this run's workspace lease — same guarantee
+    releaseRunLease(agentId, runId);   // free (or withdraw the queued wait for) this run's workspace lease — same guarantee (patch 0012)
 
   }
 }
@@ -27821,7 +27863,7 @@ function computeVersionSurface() {
 async function handleVersion(req, res) {
   // only the boot's first describe attempt is waited for, at most apiWaitMs (well inside the CLI's 5 s attach probe)
   await versionSource.settled(versionSource.limits.apiWaitMs);
-  const out = computeVersionSurface();
+  const out = Object.assign({}, computeVersionSurface(), { capabilities: [WORKSPACE_LEASE_CAPABILITY] });   // patch 0012
   res.writeHead(200, { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' });
   res.end(JSON.stringify(out));
 }
diff --git a/test/e2e.workspace-lease-per-folder.test.js b/test/e2e.workspace-lease-per-folder.test.js
new file mode 100644
index 00000000..82cafbe4
--- /dev/null
+++ b/test/e2e.workspace-lease-per-folder.test.js
@@ -0,0 +1,153 @@
+/* node test/e2e.workspace-lease-per-folder.test.js — CaPheOS patch 0012, end to end: boot the ACTUAL sidecar and drive two
+   runs of ONE agent whose (mocked) model calls fs_write, each run in a blessed project folder (projectRoot).
+     1. DIFFERENT FOLDERS: run A takes its folder's lease and stays live on a held final turn; run B, in another folder,
+        writes at once (no wait, no workspace-busy) while A is still live. Both files land, each in its own folder.
+     2. SAME FOLDER (STARNET_WORKSPACE_LEASE_WAIT_MS=250): B's write in A's folder is refused workspace-busy and does not
+        land, exactly as two runs of one agent were serialised before the patch.
+     3. AGENT-WIDE OPERATIONS still exclude a run in a folder: POST /api/autonomy/write for the agent answers 409
+        "workspace busy" while A holds its folder lease, and succeeds once A has ended.
+     4. GET /api/version names the capability ("workspace-lease-per-folder") that CaPheOS lanes probe for.
+   No real key, no network. */
+'use strict';
+const A = require('./_assert.js');
+const http = require('http');
+const path = require('path');
+const os = require('os');
+const fs = require('fs');
+const { spawn } = require('child_process');
+const { bootToken } = require('./_httpToken.js');
+const { userWords } = require('./helpers/host-notes.js');
+const { allocatePort, BIND_REFUSED } = require('./helpers/ports.js');
+const HOST = '127.0.0.1';
+const INDEX = path.resolve(__dirname, '..', 'sidecar', 'index.js');
+const TOKEN = 'lease-per-folder-test-token';
+
+// mock OpenRouter (the same three turns as e2e.workspace-lease.test.js): brief_proceed, fs_write, final text (held on SLOWFINISH)
+function startMockOpenRouter() {
+  const requests = []; const held = new Map();
+  return new Promise((resolve) => {
+    const server = http.createServer((req, res) => {
+      if (req.url.indexOf('/models') >= 0) {
+        res.writeHead(200, { 'Content-Type': 'application/json' });
+        res.end(JSON.stringify({ data: [{ id: 'test/model', context_length: 8000, pricing: { prompt: '0', completion: '0' }, supported_parameters: ['tools'] }] }));
+        return;
+      }
+      if (req.url.indexOf('/chat/completions') >= 0) {
+        let body = ''; req.on('data', d => { body += d; }); req.on('end', () => {
+          let msgs = []; try { msgs = (JSON.parse(body).messages) || []; } catch (_) {}
+          requests.push(msgs);
+          const toolResults = msgs.filter(m => m && m.role === 'tool').length;
+          const lastUser = [...msgs].reverse().find(m => m && m.role === 'user');
+          const directive = lastUser ? userWords(lastUser) : '';
+          const m = /WRITE\s+(\S+)/.exec(directive);
+          res.writeHead(200, { 'Content-Type': 'text/event-stream', 'Cache-Control': 'no-cache' });
+          const toolTurn = (id, name, args) => {
+            res.write('data: ' + JSON.stringify({ choices: [{ delta: { tool_calls: [{ index: 0, id, type: 'function', function: { name, arguments: JSON.stringify(args) } }] } }] }) + '\n\n');
+            res.write('data: ' + JSON.stringify({ choices: [{ finish_reason: 'tool_calls', delta: {} }], usage: { prompt_tokens: 8, completion_tokens: 4, total_tokens: 12 } }) + '\n\n');
+            res.write('data: [DONE]\n\n'); res.end();
+          };
+          if (toolResults === 0 && m) { toolTurn('p1', 'brief_proceed', { objective: 'write the requested file' }); return; }
+          if (toolResults === 1 && m) { toolTurn('w1', 'fs_write', { path: m[1], content: 'payload of ' + m[1] }); return; }
+          const finish = () => {
+            res.write('data: ' + JSON.stringify({ choices: [{ delta: { content: 'work complete' } }] }) + '\n\n');
+            res.write('data: ' + JSON.stringify({ choices: [{ delta: {}, finish_reason: 'stop' }], usage: { prompt_tokens: 8, completion_tokens: 4, total_tokens: 12 } }) + '\n\n');
+            res.write('data: [DONE]\n\n'); res.end();
+          };
+          if (directive.indexOf('SLOWFINISH') >= 0 && m) held.set(m[1], finish); else finish();
+        });
+        return;
+      }
+      res.writeHead(404); res.end();
+    });
+    server.listen(0, HOST, () => resolve({ server, requests, held,
+      release(name) { const finish = held.get(name); held.delete(name); if (finish) finish(); },
+      base: 'http://' + HOST + ':' + server.address().port + '/api/v1' }));
+  });
+}
+
+function boot(port, env, attemptsLeft) {
+  return new Promise((resolve, reject) => {
+    const child = spawn(process.execPath, [INDEX], { env: Object.assign({}, process.env, env, { SKYNET_PORT: String(port) }), stdio: ['ignore', 'pipe', 'pipe'] });
+    let out = '', settled = false;
+    const onData = d => {
+      out += d.toString();
+      if (!settled && out.indexOf('http://' + HOST + ':' + port) >= 0) { settled = true; resolve({ child, port }); }
+      else if (!settled && BIND_REFUSED.test(out)) { settled = true; try { child.kill(); } catch (_) {} if (attemptsLeft > 0) resolve(allocatePort().then(next => boot(next, env, attemptsLeft - 1))); else reject(new Error('no free port')); }
+    };
+    child.stdout.on('data', onData); child.stderr.on('data', onData);
+    child.on('error', e => { if (!settled) { settled = true; reject(e); } });
+    child.on('close', code => { if (!settled) { settled = true; reject(new Error('sidecar exited before it was up (' + code + ')' + ':\n' + out)); } });
+    setTimeout(() => { if (!settled) { settled = true; try { child.kill(); } catch (_) {} reject(new Error('boot timeout:\n' + out)); } }, 30000).unref();
+  });
+}
+
+const H = (token, B) => ({ 'Content-Type': 'application/json', 'X-StarNet-Token': token, Origin: B });
+async function bless(B, token, dir) {
+  const r = await fetch(B + '/api/projects/bless', { method: 'POST', headers: H(token, B), body: JSON.stringify({ path: dir }) });
+  const j = await r.json().catch(() => ({}));
+  if (!j.ok) throw new Error('bless ' + dir + ' failed: ' + JSON.stringify(j));
+}
+async function driveRun(B, token, agentId, text, streamId, projectRoot) {
+  const res = await fetch(B + '/api/run', { method: 'POST', headers: H(token, B),
+    body: JSON.stringify({ key: 'sk-or-v1-fake', model: 'test/model', agentId, streamId, isTask: true, placed: ['cabinet'], projectRoot, messages: [{ role: 'user', content: text }] }) });
+  return res.text();
+}
+const endsOf = raw => raw.split('\n').map(l => l.trim()).filter(Boolean).map(l => { try { return JSON.parse(l); } catch (_) { return null; } })
+  .filter(e => e && e.name === 'agent.run.end').map(e => e.payload.reason);
+async function untilReady(check, label) {
+  const deadline = Date.now() + 15000;
+  while (!check()) { if (Date.now() >= deadline) throw new Error('timed out waiting for ' + label); await new Promise(r => setTimeout(r, 20)); }
+}
+const dir = name => fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), name)));
+
+(async () => {
+  const mock = await startMockOpenRouter();
+  async function station(extraEnv, fn) {
+    const ws = dir('wlease-pf-ws-');
+    const env = Object.assign({ SKYNET_WORKSPACES: ws, SKYNET_OPENROUTER_BASE: mock.base, SKYNET_FULL_ACCESS: '1', STARNET_API_TOKEN: TOKEN }, extraEnv);
+    const { child, port } = await boot(await allocatePort(), env, 25);
+    const B = 'http://' + HOST + ':' + port;
+    try { const token = (await bootToken(B, B)) || TOKEN; await fn(B, token, ws); } finally { try { child.kill(); } catch (_) {} }
+  }
+
+  // ===== 1 + 3 + 4: different folders run at once; an agent-wide operation still waits for a folder run =====
+  await station({}, async (B, token) => {
+    const ver = await (await fetch(B + '/api/version', { headers: H(token, B) })).json();
+    A.ok(Array.isArray(ver.capabilities) && ver.capabilities.includes('workspace-lease-per-folder'), 'GET /api/version names the workspace-lease-per-folder capability');
+    const X = dir('wlease-pf-x-'), Y = dir('wlease-pf-y-');
+    await bless(B, token, X); await bless(B, token, Y);
+    const pA = driveRun(B, token, 'lane-agent', 'WRITE a.txt SLOWFINISH', 'sess-a', X);
+    await untilReady(() => mock.held.has('a.txt') && fs.existsSync(path.join(X, 'a.txt')), 'A holds the lease of folder X');
+    const t0 = Date.now();
+    const aw = await fetch(B + '/api/autonomy/write', { method: 'POST', headers: H(token, B), body: JSON.stringify({ agentId: 'lane-agent', path: 'drafts/x.md', content: 'x' }) });
+    A.eq(aw.status, 409, 'an agent-wide operation (autonomy write) is refused while a run of the agent holds a folder lease');
+    const rawB = await driveRun(B, token, 'lane-agent', 'WRITE b.txt', 'sess-b', Y);   // A is still live and held
+    A.ok(mock.held.has('a.txt'), 'run A was still live while run B ran');
+    A.eq(endsOf(rawB)[0], 'done', 'scenario 1: run B (other folder) completed clean while A was live');
+    A.ok(rawB.indexOf('workspace-busy') < 0 && rawB.indexOf('workspace busy') < 0, 'scenario 1: B never saw workspace busy');
+    A.ok(Date.now() - t0 < 30000, 'scenario 1: B did not wait for the 45 s lease timeout');
+    A.ok(fs.existsSync(path.join(Y, 'b.txt')), 'scenario 1: B\'s file landed in folder Y while A was live');
+    mock.release('a.txt');
+    A.eq(endsOf(await pA)[0], 'done', 'scenario 1: run A completed clean');
+    A.ok(fs.existsSync(path.join(X, 'a.txt')) && !fs.existsSync(path.join(X, 'b.txt')) && !fs.existsSync(path.join(Y, 'a.txt')), 'scenario 1: each file is in its own folder');
+    const aw2 = await fetch(B + '/api/autonomy/write', { method: 'POST', headers: H(token, B), body: JSON.stringify({ agentId: 'lane-agent', path: 'drafts/x.md', content: 'x' }) });
+    A.ok(aw2.status !== 409, 'the agent-wide operation is no longer refused as busy once the folder run ended (HTTP ' + aw2.status + ')');
+  });
+
+  // ===== 2: the SAME folder stays serialised (bounded refusal, as before the patch) =====
+  await station({ STARNET_WORKSPACE_LEASE_WAIT_MS: '250' }, async (B, token) => {
+    const X = dir('wlease-pf-same-');
+    await bless(B, token, X);
+    const pA = driveRun(B, token, 'lane-agent', 'WRITE a2.txt SLOWFINISH', 'sess-a2', X);
+    await untilReady(() => mock.held.has('a2.txt') && fs.existsSync(path.join(X, 'a2.txt')), 'A2 holds the lease of folder X');
+    const rawB = await driveRun(B, token, 'lane-agent', 'WRITE b2.txt', 'sess-b2', X);
+    mock.release('a2.txt');
+    A.eq(endsOf(await pA)[0], 'done', 'scenario 2: the lease holder completed clean');
+    A.eq(endsOf(rawB)[0], 'done', 'scenario 2: the refused run still completed clean (tool error, not run error)');
+    A.ok(rawB.indexOf('workspace-busy') >= 0, 'scenario 2: B in the SAME folder got the truthful workspace-busy refusal');
+    A.ok(!fs.existsSync(path.join(X, 'b2.txt')), 'scenario 2: the refused write did NOT land');
+  });
+
+  try { mock.server.close(); } catch (_) {}
+  A.report('e2e.workspace-lease-per-folder.test');
+})().catch(e => { console.error(e); process.exit(1); });
