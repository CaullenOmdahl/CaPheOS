+}
+// every browser this process launched and has not seen exit: ended (the whole group) when the process exits
+const liveBrowsers = new Set();
+let exitHooked = false;
+function killGroupNow(pid) {
+  if (!Number.isInteger(pid) || pid <= 1) return;
+  try { process.kill(-pid, 'SIGKILL'); } catch (_) { try { process.kill(pid, 'SIGKILL'); } catch (_) {} }
+}
+function trackBrowser(child, env) {
+  if (!child || !child.pid || !ownGroupEnabled(env)) return child;
+  liveBrowsers.add(child);
+  if (typeof child.once === 'function') child.once('close', () => liveBrowsers.delete(child));
+  if (!exitHooked) {
