+}
+// a first line for a POSIX shell command that raises its own (and so its children's) out-of-memory score
+function oomPrefix(env, platform) {
+  if ((platform || process.platform) !== 'linux') return '';
+  const n = num(env, 'STARNET_SHELL_OOM_ADJ');
+  if (!Number.isInteger(n) || n < 0 || n > 1000) return '';
+  return '{ echo ' + n + ' > /proc/self/oom_score_adj; } 2>/dev/null\n';
+}
+
+// ---- browser ----
+const LOWMEM_FLAGS = ['--enable-low-end-device-mode', '--js-flags=--max-old-space-size=256', '--disk-cache-size=33554432',
+  '--disable-extensions', '--disable-background-networking', '--disable-component-update', '--disable-sync',
+  '--disable-default-apps', '--no-first-run'];
+const LOWMEM_DISABLED_FEATURES = ['Translate', 'MediaRouter', 'OptimizationHints'];
+function ownGroupEnabled(env, platform) { return (platform || process.platform) !== 'win32' && on(env, 'STARNET_BROWSER_OWN_GROUP'); }
