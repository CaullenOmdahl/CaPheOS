+/* sidecar/memory-lifecycle.js — CaPheOS patch 0020: what the station starts ends with it, and costs as little memory as
+   the host asked for. Every helper reads one env var and, with that var unset, changes nothing (today's behaviour).
+
+     STARNET_SHELL_REAP_GROUP=1      a finished foreground shell.exec takes its whole process group with it (a probe's
+                                     `chrome … &` or `sleep 300 >/dev/null &` no longer outlives the call). Long-lived
+                                     processes belong to the background shell tool (shell.bg), which is not touched.
+     STARNET_SHELL_OOM_ADJ=<0-1000>  each foreground command raises its own oom_score_adj (a raise only, which an
+                                     unprivileged process may do), so under memory pressure the kernel ends a build
+                                     before the station. Linux only.
+     STARNET_BROWSER_OWN_GROUP=1     a launched Chrome leads its own process group, keeps its temp files in
+                                     <profile>/.tmp, and (a temporary profile only) is cut off from the session bus so
+                                     it cannot move itself into an app-com.google.Chrome-*.scope outside the station's
+                                     unit. close() ends the whole group; the station's exit ends every browser left.
+                                     The durable station profile keeps the session bus: Chrome keeps its cookie
+                                     encryption key in the desktop keyring through it, and cutting it off would sign
+                                     the station out of every site.
+     STARNET_BROWSER_LOWMEM=1        low-memory Chrome flags (below). --renderer-process-limit is NOT one of them: it
+                                     weakens site isolation and sits behind its own STARNET_BROWSER_RENDERER_LIMIT.
+     STARNET_BROWSER_IDLE_MIN=<n>    the station browser closes after n idle minutes (default: browser-view.js's own).
+     STARNET_PRIVATE_BROWSERS_MAX=<n> at most n per-run browsers at once; the next waits up to 10 minutes for a slot,
+                                     then gets a plain tool error. 0 or unset = no limit. */
+'use strict';
+const path = require('node:path');
+const fs = require('node:fs');
+
+const on = (env, k) => /^(1|true|yes|on)$/i.test(String((env || process.env)[k] || ''));
+const num = (env, k) => { const raw = (env || process.env)[k]; if (raw == null || String(raw).trim() === '') return NaN; return Number(raw); };
+
+// ---- shell ----
+function reapGroupEnabled(env) { return String((env || process.env).STARNET_SHELL_REAP_GROUP || '') === '1'; }
+/* End what is left of a finished command's process group: SIGTERM now, SIGKILL after graceMs to whatever is still there.
+   The leader (the shell) has exited, but its group id stays taken while any member lives, so -pid reaches exactly the
+   command's leftovers. pid > 1 always: kill(-1) would signal every process this user owns. */
+function reapGroup(pid, opts) {
+  const o = opts || {};
+  const kill = o.kill || ((p, s) => process.kill(p, s));
+  if (!Number.isInteger(pid) || pid <= 1) return false;
+  try { kill(-pid, 0); } catch (_) { return false; }   // nothing left in the group
+  try { kill(-pid, 'SIGTERM'); } catch (_) { return false; }
