+    process.on('exit', () => { for (const c of liveBrowsers) if (c.exitCode === null && c.signalCode === null) killGroupNow(c.pid); });
+  }
+  return child;
+}
+// close(): the whole group when the browser leads one, else the main process as before
+function killBrowser(child, env) {
+  if (!child) return;
+  if (ownGroupEnabled(env) && Number.isInteger(child.pid) && child.pid > 1) { try { process.kill(-child.pid, 'SIGKILL'); return; } catch (_) {} }
+  child.kill('SIGKILL');
+}
+// after the browser itself has exited: any member of its group still alive (a helper) is ended
+function endGroup(child, env) {
+  if (!child || !ownGroupEnabled(env) || !Number.isInteger(child.pid) || child.pid <= 1) return;
+  try { process.kill(-child.pid, 'SIGKILL'); } catch (_) {}
+}
