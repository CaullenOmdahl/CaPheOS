+
+// ---- a cap on per-run browsers ----
+function makeSlots(o) {
+  const max = o.max, waitMs = o.waitMs == null ? 600000 : o.waitMs;
+  const setT = o.setTimeout || setTimeout, clearT = o.clearTimeout || clearTimeout;
+  let used = 0;
+  const queue = [];
+  function grant() {
+    used++;
+    let released = false;
+    return () => {
+      if (released) return; released = true; used--;
+      while (queue.length && used < max) { const w = queue.shift(); clearT(w.timer); w.resolve(grant()); }
+    };
+  }
+  function acquire() {
+    if (used < max) return Promise.resolve(grant());
+    return new Promise((resolve, reject) => {
+      const w = { resolve, timer: null };
+      w.timer = setT(() => {
+        const i = queue.indexOf(w); if (i >= 0) queue.splice(i, 1);
+        const err = new Error('No browser is free on this station right now (' + used + ' in use). Try again later or work without the browser.');
+        err.code = 'BROWSER_SLOTS_FULL';
+        reject(err);
+      }, waitMs);
+      queue.push(w);
+    });
+  }
+  return { acquire, inUse: () => used, waiting: () => queue.length, max };
+}
+let privateSlots = null;
+// the station's one per-run browser cap, or null (no limit)
+function privateBrowserSlots(env) {
+  const n = num(env, 'STARNET_PRIVATE_BROWSERS_MAX');
+  if (!Number.isInteger(n) || n <= 0) return null;
+  if (!privateSlots || privateSlots.max !== n) privateSlots = makeSlots({ max: n });
+  return privateSlots;
+}
+
+module.exports = { reapGroupEnabled, reapGroup, oomPrefix, browserArgs, browserSpawnOptions, profileTmpFits, trackBrowser, killBrowser, endGroup,
+  stationIdleMs, makeSlots, privateBrowserSlots, ownGroupEnabled, LOWMEM_FLAGS };
