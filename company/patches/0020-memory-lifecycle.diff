+  if (childEnv.TMPDIR !== tmp && childEnv.TMPDIR && !profileTmpFits(childEnv.TMPDIR)) childEnv.TMPDIR = '/tmp';
+  if (!o.persistent && !o.headed) childEnv.DBUS_SESSION_BUS_ADDRESS = 'disabled:';
