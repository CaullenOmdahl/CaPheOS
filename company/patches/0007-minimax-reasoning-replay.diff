+      const isMiniMaxEndpoint = u => { try { return /(^|\.)minimaxi?\.(io|com)$/i.test(new URL(String(u || '')).hostname); } catch (_) { return false; } };   // CA PHE DIGITAL (0007)
       const wire = (id === 'custom' && looksLikeOllama(opts.baseUrl || profile.baseUrl) && registry.getProviderProfile('ollama')) || profile;
