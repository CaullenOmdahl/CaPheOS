+/* node test/minimax-reasoning-replay.test.js — CA PHE DIGITAL (company/patches/0007): a custom endpoint on MiniMax's API
+   hands each turn's reasoning_content back on the next request of a tool loop; other custom endpoints never do. */
+'use strict';
+const factory = require('../sidecar/providers/factory.js');
+let fails = 0; const ok = (c, m) => { if (!c) { fails++; console.log('FAIL ' + m); } else console.log('ok   ' + m); };
+const SSE = chunks => new Response(chunks.map(c => 'data: ' + JSON.stringify(c) + '\n\n').join('') + 'data: [DONE]\n\n', { status: 200, headers: { 'content-type': 'text/event-stream' } });
+const TOOLS = [{ type: 'function', function: { name: 'fs_read', description: 'read', parameters: { type: 'object', properties: { path: { type: 'string' } } } } }];
+function endpoint() {
+  const posts = [];
+  const fetch = async (url, init) => {
+    if (init && init.method === 'POST') {
+      posts.push(JSON.parse(init.body));
+      if (posts.length === 1) return SSE([
+        { choices: [{ delta: { reasoning_content: 'I should read ' } }] },
+        { choices: [{ delta: { reasoning_content: 'the file first.' } }] },
+        { choices: [{ delta: { tool_calls: [{ index: 0, id: 'call_1', function: { name: 'fs_read', arguments: '{"path":"a.txt"}' } }] }, finish_reason: 'tool_calls' }] }]);
+      return SSE([{ choices: [{ delta: { content: 'done' }, finish_reason: 'stop' }] }]);
+    }
+    return new Response(JSON.stringify({ data: [{ id: 'MiniMax-M3.1-Flash', object: 'model' }] }), { status: 200 });
+  };
+  return { fetch, posts };
+}
+async function collect(p, req) { const out = []; for await (const e of p.stream(req)) out.push(e); return out; }
+(async () => {
+  for (const [base, expect] of [['https://api.minimax.io/v1', true], ['https://api.minimaxi.com/v1', true], ['http://127.0.0.1:1234/v1', false]]) {
+    const ep = endpoint();
+    const p = factory.selectProvider({ provider: 'custom', fetch: ep.fetch, key: 'fixture-key', baseUrl: base });
+    const history = [{ role: 'user', content: 'read a.txt' }];
+    const ev1 = await collect(p, { model: 'MiniMax-M3.1-Flash', messages: history, tools: TOOLS });
+    const block = ev1.find(e => e.type === 'reasoning' && e.block);
+    ok(!!block === expect, base + ': reasoning ' + (expect ? 'is' : 'is not') + ' parked on the turn');
+    const turn = { role: 'assistant', content: '', tool_calls: [{ id: 'call_1', type: 'function', function: { name: 'fs_read', arguments: '{"path":"a.txt"}' } }], reasoning: block ? [block.block] : undefined };
+    await collect(p, { model: 'MiniMax-M3.1-Flash', messages: history.concat([turn, { role: 'tool', tool_call_id: 'call_1', content: 'hello' }]), tools: TOOLS });
+    const sent = ep.posts[1].messages.find(x => x.tool_calls);
+    if (expect) ok(sent.reasoning_content === 'I should read the file first.', base + ': reasoning_content rides back on its own turn');
+    else ok(sent.reasoning_content === undefined, base + ': a non-MiniMax custom endpoint gets no reasoning_content');
+    ok(sent.reasoning === undefined, base + ': the parking field never reaches the wire');
+  }
+  console.log(fails ? fails + ' FAILED' : 'all passed'); process.exit(fails ? 1 : 0);
+})();
