+  // ---- noteStep: write a step's NOTE without touching its done flag. Works on an open or a done step of an OPEN quest;
+  //      an empty note is a no-op (it would otherwise erase one). Returns true only if a note was written. ----
+  function noteStep(id, stepKey, note, now) {
+    let out = false;
+    return durable.update(STORE_KEY, (cur) => {
+      const rec = normalize(cur);
+      const q = rec.quests.find(x => x.id === String(id));
+      if (!q || q.status !== 'open') return undefined;
+      const st = q.steps.find(s => s.key === String(stepKey));
+      const text = String(note == null ? '' : note).trim();
+      if (!st || !text) return undefined;
+      // a DONE step's note is the evidence its tick was made on: append to it, never overwrite it
+      st.note = st.done && st.note ? clip(st.note + ' | note: ' + text, 240) : clip(text, 240);
+      out = true;
+      return rec;
+    }).then(() => out);
+  }
+
+  // ---- untickStep: REPAIR. Put a step that was ticked in error back to not-done, on an OPEN quest only (a closed
+  //      quest is not reopened here). A reason is mandatory; it goes first, "unticked: <reason> (was: <old note>)", so the
+  //      correction and the withdrawn claim both stay readable. Idempotent: a step that is not done is a no-op. ----
+  function untickStep(id, stepKey, reason, now) {
+    let out = false;
+    return durable.update(STORE_KEY, (cur) => {
+      const rec = normalize(cur);
+      const q = rec.quests.find(x => x.id === String(id));
+      if (!q || q.status !== 'open') return undefined;
+      const st = q.steps.find(s => s.key === String(stepKey));
+      const why = String(reason == null ? '' : reason).trim();
+      if (!st || !st.done || !why) return undefined;
+      st.done = false;
+      // reason first, then the note the tick was made on, so the claim that was withdrawn stays readable
+      st.note = clip('unticked: ' + why + (st.note ? ' (was: ' + st.note + ')' : ''), 240);
+      out = true;
+      return rec;
+    }).then(() => out);
+  }
