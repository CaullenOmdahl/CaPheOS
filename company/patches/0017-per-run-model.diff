+    const write = (at, agents, extra) => fs.writeFileSync(file, JSON.stringify(Object.assign({ v: 1, at, by: 'dispatcher', agents }, extra || {})));
+    const ask = (agentId, provider, model, override) => gate.check({ agentId, provider, model, override: override || { model } });
+    const OFF = /^no current override allowlist: overrides are off$/;
