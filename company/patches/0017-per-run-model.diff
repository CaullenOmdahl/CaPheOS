+++ b/sidecar/override-allow.js
@@ -0,0 +1,91 @@
+/* sidecar/override-allow.js — THE OVERRIDE ALLOWLIST: which one-run models are open for which agent NOW
+   (CA PHE DIGITAL, company/patches/0017).
+
+   WHY. A one-run override (POST /api/cron/run, a team.dispatch worker spec: sidecar/run-override.js) names a provider and
+   a model directly. Unchecked, any lead agent or any Run Now caller could pick any provider/model this station holds a
+   credential for, around everything the company decides about models: the pacer's closures, the owner's subscription
+   stops, refusal blocks, the owner's model rulings. The station does not know those rules; the company does. So the
+   company's dispatcher writes, at the end of every tick, the pairs each agent may run NOW (company/tools/lib/
+   override-allow.js), and the station accepts an override only when it matches that list.
+
+   THE FILE. The absolute path named by env STARNET_OVERRIDE_ALLOW, read on each request (cached by path + mtime + size):
+     { "v": 1, "at": <epoch ms written>, "by": "dispatcher", "agents": { "<agentId>": [ { "provider": "...", "model": "..." } ] } }
+
+   THE RULE (fail closed).
+     - env unset or empty, file missing, unreadable, not JSON, not v:1, no agents object, or "at" older than MAX_AGE_MS
+       (30 minutes; a stopped dispatcher stops writing, and a list that old no longer says what is open now), or "at" more
+       than a minute in the future (a far-future stamp would never go stale)
+         -> every override is refused: OFF_REASON.
+     - otherwise an override that names a model is accepted only when its (provider, model), after a bare model borrowed
+       the run's own provider (the caller resolves that pair the way the run will run it), equals one entry listed for
+       THE RUN'S OWN agentId. Another agent's entries never count. Effort is free: an effort-only override runs the
+       run's own saved pair, so it needs a current list but matches no entry.
+     - no match -> 'model <provider>/<model> is not open for <agentId> now'.
+
+     makeOverrideAllow({ envName?, env?, fs?, now? }) -> { check({ agentId, provider, model, override }) -> { ok:true } | { ok:false, error },
+                                                          read() -> { ok:true, list } | { ok:false } }
+     matchAllow(list, { agentId, provider, model, override }, nowMs) -> the same answer as check, over a parsed list. */
+'use strict';
+const nodeFs = require('fs');
+
+const MAX_AGE_MS = 30 * 60 * 1000;
+const OFF_REASON = 'no current override allowlist: overrides are off';
+const ENV_NAME = 'STARNET_OVERRIDE_ALLOW';
+
+function parseList(text) {
+  let j; try { j = JSON.parse(text); } catch (_) { return null; }
+  if (!j || typeof j !== 'object' || j.v !== 1) return null;
+  const at = Number(j.at);
+  if (!Number.isFinite(at) || at <= 0) return null;
+  if (!j.agents || typeof j.agents !== 'object' || Array.isArray(j.agents)) return null;
+  const agents = Object.create(null);
+  for (const id of Object.keys(j.agents)) {
+    const rows = Array.isArray(j.agents[id]) ? j.agents[id] : [];
+    agents[id] = rows.filter(r => r && typeof r.provider === 'string' && typeof r.model === 'string' && r.provider && r.model)
+      .map(r => ({ provider: r.provider.trim().toLowerCase(), model: r.model.trim() }));
+  }
+  return { at, by: String(j.by || ''), agents };
+}
+
+function matchAllow(list, ask, nowMs) {
+  const now = Number.isFinite(nowMs) ? nowMs : Date.now();
+  // older than MAX_AGE_MS, or stamped more than a clock-skew minute ahead (a far-future stamp would never go stale)
+  if (!list || !(now - list.at <= MAX_AGE_MS) || list.at - now > 60 * 1000) return { ok: false, error: OFF_REASON };
+  const a = ask || {};
+  const ov = a.override || {};
+  if (!ov.model) return { ok: true };   // effort only: the run's own pair, at that effort
+  const agentId = String(a.agentId || '');
+  const provider = String(a.provider || '').trim().toLowerCase();
+  const model = String(a.model || ov.model).trim();
+  const open = (agentId && Object.prototype.hasOwnProperty.call(list.agents, agentId)) ? list.agents[agentId] : [];
+  if (provider && open.some(r => r.provider === provider && r.model === model)) return { ok: true };
+  return { ok: false, error: 'model ' + (provider || '?') + '/' + model + ' is not open for ' + (agentId || '(no agent)') + ' now' };
+}
+
+function makeOverrideAllow(opts) {
+  const o = opts || {};
+  const fs = o.fs || nodeFs;
+  const env = o.env || process.env;
+  const envName = o.envName || ENV_NAME;
+  const now = typeof o.now === 'function' ? o.now : Date.now;
+  let cache = null;   // { file, mtimeMs, size, list }
+  function read() {
+    const file = String(env[envName] || '').trim();
+    if (!file || !require('path').isAbsolute(file)) return { ok: false };
+    let st; try { st = fs.statSync(file); } catch (_) { cache = null; return { ok: false }; }
+    if (!st.isFile()) return { ok: false };
+    if (cache && cache.file === file && cache.mtimeMs === st.mtimeMs && cache.size === st.size) return cache.list ? { ok: true, list: cache.list } : { ok: false };
+    let text; try { text = fs.readFileSync(file, 'utf8'); } catch (_) { cache = null; return { ok: false }; }
+    const list = text.length <= 4 * 1024 * 1024 ? parseList(text) : null;
+    cache = { file, mtimeMs: st.mtimeMs, size: st.size, list };
+    return list ? { ok: true, list } : { ok: false };
+  }
+  function check(ask) {
+    const r = read();
+    if (!r.ok) return { ok: false, error: OFF_REASON };
+    return matchAllow(r.list, ask, now());
+  }
+  return { check, read };
+}
+
+module.exports = { makeOverrideAllow, matchAllow, parseList, MAX_AGE_MS, OFF_REASON, ENV_NAME };
