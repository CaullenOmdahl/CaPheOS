+    fs.writeFileSync(file, '{not json');
+    A.ok(OFF.test(ask('w1', 'openrouter', 'm').error), 'allow: bad JSON -> refused');
+    write(now, { w1: [{ provider: 'openrouter', model: 'm' }] }, { v: 2 });
