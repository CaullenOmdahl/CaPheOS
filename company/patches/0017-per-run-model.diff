+      from = seen.length;
+      const refusedWith = async (label, want) => {
+        const r = await fixture.json('POST', '/api/cron/run', { id, model: OTHER });
+        A.ok(r.status === 403 && String((r.body && r.body.error) || '') === want, 'G: ' + label + ' -> 403 "' + want + '" (' + r.status + ' ' + String((r.body && r.body.error) || r.text || '').slice(0, 160) + ')');
