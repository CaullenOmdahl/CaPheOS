+    const resolveWire = (aid, explicit) => (explicit && explicit.model) ? { ok: true, provider: explicit.provider || 'openrouter', model: explicit.model, source: 'explicit' } : { ok: true, provider: 'openrouter', model: roster.get(aid).model, source: 'agent' };
+    const { dispatchTool } = makeOrchestrationTools(Object.assign({ runOnce, roster: () => roster, key: 'LEAD-KEY', model: 'lead-m', provider: 'openrouter', newId: () => 'q' + (++n), resolveWire, parseOverride: parse }, extra));
