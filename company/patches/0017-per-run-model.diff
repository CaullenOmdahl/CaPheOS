+    const toolMsgs = seen.slice(from).filter(s => s.who === 'lead' && s.tools > 0);
+    A.ok(toolMsgs.some(s => s.toolText.indexOf('model openrouter/' + OTHER + ' is not open for worker now') >= 0), 'E: the lead got the refused worker\'s error row with its reason');
+    const eRows = runRows(fixture.workspace).slice(rowsBeforeE).filter(r => r.agentId === 'worker');
+    A.ok(eRows.length === 1 && !('override' in eRows[0]), 'E: one worker run row, the plain one (' + eRows.length + ')');
+  } catch (e) {
+    A.ok(false, 'run-model-override e2e: ' + ((e && e.stack) || e) + '\n' + String(fixture.output ? fixture.output() : '').slice(-3000));
+  } finally {
+    try { await fixture.stop(); } catch (_) {}
+    try { server.close(); } catch (_) {}
+    try { fs.rmSync(ALLOW_DIR, { recursive: true, force: true }); } catch (_) {}
+  }
+  A.report('run-model-override.e2e');
+})();
