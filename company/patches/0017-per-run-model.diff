+/* node test/run-model-override.e2e.test.js — A MODEL FOR ONE RUN ONLY (CA PHE DIGITAL, company/patches/0017).
+
+   POST /api/cron/run and each team.dispatch worker spec take an optional { model, provider, effort } for THAT run only
+   (sidecar/run-override.js). The real sidecar (test/helpers/sidecar-fixture.js) with a mock OpenRouter on loopback as
+   the only fake; every chat request it receives is recorded with the model it was sent.
+     A. Run Now with { model } runs on that model; WHILE the run is in flight the routine's saved model and the agent's
+        roster pin still read the saved ones; the run row says requestedBy 'override' and what was asked.
+     B. the next Run Now without an override runs on the routine's saved model again; its row names no override.
+     C. an override that is not well formed, names an unknown provider, a provider with no model, or an unknown effort
+        is a 400 with its reason, and starts nothing.
+     D. one team.dispatch with a worker that carries an override and one that does not: each runs on its own model, the
+        worker's pin is unchanged, and only the overridden worker's run row says requestedBy 'override'.
+   THE ALLOWLIST (sidecar/override-allow.js, env STARNET_OVERRIDE_ALLOW): every override above runs only because the
+   company's list opens that pair for that run's own agent now.
+     G. a station with no STARNET_OVERRIDE_ALLOW refuses every override (403, "overrides are off"); with the env set, a
+        missing file, a stale list (at older than 30 minutes) and a list that opens the pair only for ANOTHER agent are
+        each a 403 with its reason, and none reaches the provider. A plain Run Now still runs.
+     E. a dispatch while the list does not open the worker's override: that worker gets the error row and never reaches the
+        provider, while its sibling without an override runs on its own pin. */
+'use strict';
+const A = require('./_assert.js');
+const fs = require('fs');
+const path = require('path');
+const http = require('http');
+const { SidecarFixture } = require('./helpers/sidecar-fixture.js');
+
+const SAVED = 'test/model', OTHER = 'test/other';
+const ROUTINE_MARK = 'ROUTINE_MARK say hello.';
+const DISPATCH_MARK = 'DISPATCH_MARK hand out two tasks.';
+const seen = [];   // every chat request: { model, who, lastUser }
+let holdRoutine = null;   // a promise the routine's first request waits on (so the test reads saved state mid-run)
+const os = require('os');
+const ALLOW_DIR = fs.mkdtempSync(path.join(os.tmpdir(), 'override-allow-e2e-'));
+const ALLOW = path.join(ALLOW_DIR, 'override-allow.json');
+const writeAllow = (agents, at) => fs.writeFileSync(ALLOW, JSON.stringify({ v: 1, at: at == null ? Date.now() : at, by: 'dispatcher', agents }));
+const OFF = 'no current override allowlist: overrides are off';
+const sleep = ms => new Promise(r => setTimeout(r, ms));
+const textOf = m => (typeof m.content === 'string' ? m.content : JSON.stringify(m.content == null ? '' : m.content));
+
+const server = http.createServer((req, res) => {
+  let raw = ''; req.on('data', b => { raw += b; }); req.on('end', async () => {
+    if (req.method !== 'POST') {
+      res.setHeader('Content-Type', 'application/json');
+      return res.end(JSON.stringify({ data: [SAVED, OTHER].map(id => ({ id, context_length: 64000, pricing: { prompt: '0', completion: '0' }, supported_parameters: ['tools'] })) }));
+    }
+    let b = {}; try { b = JSON.parse(raw || '{}'); } catch (_) { b = {}; }
