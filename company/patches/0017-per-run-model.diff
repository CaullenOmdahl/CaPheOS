+  }
+
+  // ---- team.dispatch: one worker with an override, one without, same dispatch ----
+  {
+    const calls = [];
+    const runOnce = async o => { calls.push(o); return { reason: 'done', messages: [{ role: 'assistant', content: 'ok ' + o.model }], usd: 0, model: o.model }; };
+    const roster = new Map([['w1', { system: 'S1', name: 'W1', model: 'own-1' }], ['w2', { system: 'S2', name: 'W2', model: 'own-2' }]]);
+    const pins = JSON.stringify([...roster]);
+    let n = 0;
+    const resolveWire = (aid, explicit) => {
+      if (explicit && explicit.model) return { ok: true, provider: explicit.provider || 'openrouter', model: explicit.model, source: 'explicit', reasoningEffort: explicit.reasoningEffort };
+      return { ok: true, provider: 'openrouter', model: roster.get(aid).model, source: 'agent' };
+    };
+    const providerAuth = p => (p === 'anthropic' ? { provider: 'anthropic', key: 'ANTH-KEY', baseUrl: '' } : null);
+    const open = { w1: [{ provider: 'openrouter', model: 'big-model' }, { provider: 'anthropic', model: 'claude-x' }], w2: [{ provider: 'claude-cli', model: 'z' }, { provider: 'openrouter', model: 'six-m' }] };
+    const allowOverride = ask => OA.matchAllow({ at: Date.now(), agents: open }, ask, Date.now());
+    const { dispatchTool } = makeOrchestrationTools({ runOnce, roster: () => roster, key: 'LEAD-KEY', model: 'lead-m', provider: 'openrouter', newId: () => 'r' + (++n), resolveWire, providerAuth, parseOverride: parse, allowOverride });
+    const out = await dispatchTool.run({ workers: [
+      { agentId: 'w1', prompt: 'one', model: 'big-model', effort: 'high' },
+      { agentId: 'w2', prompt: 'two' },
+      { agentId: 'w1', prompt: 'three', model: 'claude-x', provider: 'anthropic' },
+      { agentId: 'w2', prompt: 'four', model: 'z', provider: 'claude-cli' },
+      { agentId: 'w2', prompt: 'five', provider: 'nope', model: 'z' },
+      { agentId: 'w2', prompt: 'six', model: 'big-model' },
+      { agentId: 'w1', prompt: 'seven', model: 'six-m' }
