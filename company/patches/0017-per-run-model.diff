+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+
+const norm = id => (['openrouter', 'anthropic', 'claude-cli'].indexOf(String(id).toLowerCase()) >= 0 ? String(id).toLowerCase() : '');
+const parse = spec => RO.parseRunOverride(spec, { normalizeProvider: norm, knownProviders: ['openrouter', 'anthropic', 'claude-cli'] });
+
+(async () => {
+  // ---- parse ----
+  A.eq(parse({}), { ok: true, override: null }, 'nothing named -> no override');
+  A.eq(parse({ model: '', provider: null, effort: '  ' }), { ok: true, override: null }, 'empty fields -> no override');
+  A.eq(parse({ model: 'claude-fable-5-2[1m]' }), { ok: true, override: { model: 'claude-fable-5-2[1m]' } }, 'a bare model (the CLI context tag is a model id)');
+  A.eq(parse({ model: 'anthropic/claude-sonnet-5-5:free', provider: 'OpenRouter', effort: 'HIGH' }).override,
+    { model: 'anthropic/claude-sonnet-5-5:free', provider: 'openrouter', effort: 'high' }, 'a full override, normalised');
+  A.eq(parse({ effort: 'low' }).override, { effort: 'low' }, 'effort only');
+  A.ok(/not a provider this station knows.*openrouter/.test(parse({ provider: 'nope', model: 'm' }).error), 'unknown provider -> refused, with the known list');
+  A.ok(/names no model/.test(parse({ provider: 'anthropic' }).error), 'provider without a model -> refused');
