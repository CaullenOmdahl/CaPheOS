# 0023-sharp-block-svg.diff
# Block sharp's librsvg SVG loader (VipsForeignLoadSvg) in sidecar/local-voice.js and
# sidecar/tools/builtin/image.js to mitigate GHSA-wq5f-xc86-pv6w / CVE-2026-96889 on sharp <0.35.5.
#
# Apply:  git -C starnet apply --3way --whitespace=nowarn ../company/patches/0023-sharp-block-svg.diff
# Revert: git -C starnet apply -R ../company/patches/0023-sharp-block-svg.diff
diff --git a/sidecar/local-voice.js b/sidecar/local-voice.js
--- a/sidecar/local-voice.js
+++ b/sidecar/local-voice.js
@@ -176,7 +176,8 @@
 const BLOCKED_SHARP_LOADERS = Object.freeze([
   'VipsForeignLoadNsgif',
   'VipsForeignLoadTiff',
-  'VipsForeignLoadVips'
+  'VipsForeignLoadVips',
+  'VipsForeignLoadSvg'
 ]);
 function hardenSharpImageDecoders(sharpImpl = require('sharp')) {
   if (!sharpImpl || typeof sharpImpl.block !== 'function') {
diff --git a/sidecar/tools/builtin/image.js b/sidecar/tools/builtin/image.js
--- a/sidecar/tools/builtin/image.js
+++ b/sidecar/tools/builtin/image.js
@@ -175,9 +175,18 @@
 
   // Fit generated bytes to an exact WxH (cover-crop, centred). Uses sharp when present; returns null
   // when it isn't so the caller can ship the nearest-ratio image honestly instead of failing.
+  let sharpSvgHardened = false;
+  const BLOCKED_SHARP_LOADERS = Object.freeze([
+    'VipsForeignLoadNsgif',
+    'VipsForeignLoadTiff',
+    'VipsForeignLoadVips',
+    'VipsForeignLoadSvg'
+  ]);
   async function fitToSize(buffer, width, height) {
     let sharp; try { sharp = require('sharp'); } catch (_) { return null; }
     try {
+      if (!sharpSvgHardened && typeof sharp.block === 'function') { sharp.block({ operation: BLOCKED_SHARP_LOADERS.slice() }); sharpSvgHardened = true; }
+      if (typeof sharp.block !== 'function') return null;
       const out = await sharp(buffer).resize(width, height, { fit: 'cover', position: 'centre' }).png().toBuffer();
       return { buffer: out, mime: 'image/png' };
     } catch (_) { return null; }
