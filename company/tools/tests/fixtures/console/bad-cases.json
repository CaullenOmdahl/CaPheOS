{
  "_doc": "console-panel.js selftest: each case patches `base` (top-level keys replace) and must produce a finding matching `expect`.",
  "base": {
    "version": 1, "id": "bad-panel", "title": "A bad panel", "owner": "tools",
    "why": "Fixture panel used to prove every refusal in console-panel.js validate.",
    "placement": { "area": "today" },
    "sources": { "rows": { "type": "file", "glob": "company/work/desk/positions.json", "select": "positions" } },
    "view": { "kind": "table", "source": "rows", "columns": [{ "key": "symbol", "label": "Symbol" }] }
  },
  "cases": [
    { "name": "a tool not on the allowlist", "patch": { "sources": { "rows": { "type": "tool", "id": "rm-everything" } } }, "expect": "not an allowlisted tool" },
    { "name": "a station endpoint not on the allowlist", "patch": { "sources": { "rows": { "type": "station", "id": "halt" } } }, "expect": "not an allowlisted station" },
    { "name": "a source type outside the three", "patch": { "sources": { "rows": { "type": "http", "url": "x" } } }, "expect": "sources.rows.type: must be one of" },
    { "name": "a glob climbing out with ..", "patch": { "sources": { "rows": { "type": "file", "glob": "company/work/../../secrets/k.json" } } }, "expect": "sources.rows.glob: .*'\\.\\.'" },
    { "name": "a glob into secrets/", "patch": { "sources": { "rows": { "type": "file", "glob": "company/state/secrets/k.json" } } }, "expect": "secrets" },
    { "name": "a glob outside work/ and state/", "patch": { "sources": { "rows": { "type": "file", "glob": "company/owner/inbound.jsonl" } } }, "expect": "must start with" },
    { "name": "five sources", "patch": { "sources": { "a": { "type": "tool", "id": "handoffs-due" }, "b": { "type": "tool", "id": "handoffs-due" }, "c": { "type": "tool", "id": "handoffs-due" }, "d": { "type": "tool", "id": "handoffs-due" }, "rows": { "type": "tool", "id": "handoffs-due" } } }, "expect": "sources: at most 4" },
    { "name": "refresh under 30 s", "patch": { "refresh": 10 }, "expect": "refresh: below minimum 30" },
    { "name": "a side panel on Governance", "patch": { "placement": { "area": "side", "screen": "governance" } }, "expect": "placement.screen" },
    { "name": "a company screen called System", "patch": { "placement": { "area": "screen", "nav": "System" } }, "expect": "built-in console label" },
    { "name": "a reserved id", "patch": { "id": "needs-you" }, "expect": "id: reserved" },
    { "name": "a styling key", "patch": { "style": { "background": "red" } }, "expect": "style: not allowed" },
    { "name": "an owner that is no function or seat", "patch": { "owner": "Zed" }, "expect": "owner: not a function" },
    { "name": "no why", "drop": ["why"], "expect": "why: required" },
    { "name": "a view naming an undeclared source", "patch": { "view": { "kind": "table", "source": "nope", "columns": [{ "key": "a", "label": "A" }] } }, "expect": "no source named" },
    { "name": "a chart without explicit series", "patch": { "view": { "kind": "chart", "source": "rows", "chart": "line", "x": { "key": "at" } } }, "expect": "view.series: required" },
    { "name": "a pie chart", "patch": { "view": { "kind": "chart", "source": "rows", "chart": "pie", "x": { "key": "at" }, "series": [{ "key": "v", "label": "V" }] } }, "expect": "view.chart: must be one of" },
    { "name": "an action that pays", "patch": { "actions": [{ "id": "pay", "label": "Pay it", "kind": "payment", "text": "pay the invoice" }] }, "expect": "actions\\[0\\].kind" },
    { "name": "a direct-write action field", "patch": { "actions": [{ "id": "w", "label": "Write", "kind": "handoff", "to": "tools", "text": "hello there", "write": "company/state/x.json" }] }, "expect": "write: not allowed" },
    { "name": "a handoff with no recipient", "patch": { "actions": [{ "id": "h", "label": "Hand off", "kind": "handoff", "text": "please look" }] }, "expect": "actions\\[0\\].to" },
    { "name": "an unknown placeholder", "patch": { "actions": [{ "id": "h", "label": "Hand off", "kind": "ask-ceo", "text": "token is {{secret.key}}" }] }, "expect": "placeholder" },
    { "name": "a row placeholder on a panel action", "patch": { "actions": [{ "id": "h", "label": "Ask", "kind": "ask-ceo", "text": "about {{row.symbol}} please" }] }, "expect": "needs scope" },
    { "name": "seven Today panels is the limit's job, a stat-row of seven is the schema's", "patch": { "view": { "kind": "stat-row", "items": [{ "source": "rows", "value": "length", "label": "a" }, { "source": "rows", "value": "length", "label": "b" }, { "source": "rows", "value": "length", "label": "c" }, { "source": "rows", "value": "length", "label": "d" }, { "source": "rows", "value": "length", "label": "e" }, { "source": "rows", "value": "length", "label": "f" }, { "source": "rows", "value": "length", "label": "g" }] } }, "expect": "view.items: at most 6" },
    { "name": "custom view without view.html", "patch": { "view": { "kind": "custom", "html": "view.html" } }, "expect": "view.html is missing" },
    { "name": "custom view that fetches", "patch": { "view": { "kind": "custom", "html": "view.html" } }, "viewHtml": "<script>window.addEventListener('message',function(){});fetch('/api/halt')</script>", "expect": "no fetch" },
    { "name": "custom view with a URL", "patch": { "view": { "kind": "custom", "html": "view.html" } }, "viewHtml": "<img src=\"https://example.com/p.png\"><script>window.addEventListener('message',function(){})</script>", "expect": "no URLs" },
    { "name": "custom view with a colour literal", "patch": { "view": { "kind": "custom", "html": "view.html" } }, "viewHtml": "<style>body{color:#ff0000}</style><script>window.addEventListener('message',function(){})</script>", "expect": "colour literal" },
    { "name": "custom view with its own font", "patch": { "view": { "kind": "custom", "html": "view.html" } }, "viewHtml": "<style>body{font-family: Comic Sans}</style><script>window.addEventListener('message',function(){})</script>", "expect": "font-family" },
    { "name": "custom view with an unknown token", "patch": { "view": { "kind": "custom", "html": "view.html" } }, "viewHtml": "<style>body{color:var(--brand-red)}</style><script>window.addEventListener('message',function(){})</script>", "expect": "unknown token" },
    { "name": "custom view reaching the top window", "patch": { "view": { "kind": "custom", "html": "view.html" } }, "viewHtml": "<script>window.addEventListener('message',function(){});window.top.location='x'</script>", "expect": "parent, top" },
    { "name": "custom view reading storage", "patch": { "view": { "kind": "custom", "html": "view.html" } }, "viewHtml": "<script>window.addEventListener('message',function(){});localStorage.x=1</script>", "expect": "storage" },
    { "name": "view.html shipped with a non-custom view", "patch": {}, "viewHtml": "<p>hi</p>", "expect": "only a custom view" }
  ]
}
