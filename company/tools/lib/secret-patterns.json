{
 "_doc": "The master list of secret FORMATS removed from everything sent to a non-subscription model provider (docs/FREE-MODELS.md). One list, read by two engines that are the same file: company/tools/lib/outbound-scrub.js (the framework) and starnet/sidecar/outbound-scrub.js (StarNet patch 0022, a byte-identical copy; the station reads this file through env STARNET_SCRUB_PATTERNS). Each entry: kind (the word in the [REDACTED:<kind>] marker and in the redaction counts), re (a JavaScript regular expression source), flags (optional; g is always added), replace (optional template: $1..$9 are the pattern's groups, {R} is the marker; default: the whole match becomes the marker), minEntropy (optional: the secret part must have at least this many bits of Shannon entropy per character), needClasses (optional: it must mix at least this many of upper case, lower case, digits), notAfter (optional regex source tested against the 40 characters before the match: a hit there keeps it, e.g. a sha512- integrity hash). skipValue (optional regex, case-insensitive, tested against the secret part: a hit keeps it); codeSafe true = the list's top-level skipValue applies (values that read as code, not secrets: short pure numbers, dotted references such as self.token or process.env.X, identifiers that name a secret such as authToken, true/false/null). Order matters: the first entries are the most specific. Exact values of the company's own secrets/ files are removed before any of these (kind secret-file). Add a format here, never in code; the test is company/tools/tests/outbound-scrub.test.js.",
 "version": 2,
 "minValueLen": 9,
 "skipValue": "^(?:\\d{1,7}(?:\\.\\d+)?|[A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)+|[A-Za-z_$]*(?:password|passwd|secret|token|key|cred|auth)[A-Za-z_$]*|true|false|null|none|nil|undefined)$",
 "patterns": [
  { "kind": "private-key", "re": "-----BEGIN [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----[\\s\\S]*?(?:-----END [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----|$)" },
  { "kind": "anthropic-key", "re": "\\bsk-ant-[A-Za-z0-9_-]{16,}" },
  { "kind": "openrouter-key", "re": "\\bsk-or-[A-Za-z0-9_-]{16,}" },
  { "kind": "openai-key", "re": "\\bsk-(?:proj-|svcacct-|admin-|None-)?[A-Za-z0-9_-]{20,}" },
  { "kind": "github-token", "re": "\\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})" },
  { "kind": "gitlab-token", "re": "\\bglpat-[A-Za-z0-9_-]{16,}" },
  { "kind": "aws-key-id", "re": "\\b(?:AKIA|ASIA)[A-Z0-9]{16}\\b" },
  { "kind": "slack-token", "re": "\\bxox[abeposr]-[A-Za-z0-9-]{10,}" },
  { "kind": "google-key", "re": "\\bAIza[0-9A-Za-z_-]{35}" },
  { "kind": "google-oauth", "re": "\\bya29\\.[0-9A-Za-z_-]{20,}" },
  { "kind": "stripe-key", "re": "\\b[rsp]k_(?:live|test)_[A-Za-z0-9]{16,}" },
  { "kind": "huggingface-token", "re": "\\bhf_[A-Za-z0-9]{30,}" },
  { "kind": "npm-token", "re": "\\bnpm_[A-Za-z0-9]{30,}" },
  { "kind": "jwt", "re": "\\beyJ[A-Za-z0-9_-]{8,}\\.eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}" },
  { "kind": "slack-webhook", "re": "\\bhttps://hooks\\.slack\\.com/(?:services|workflows|triggers)/[A-Za-z0-9/_-]{20,}" },
  { "kind": "discord-webhook", "re": "\\bhttps://(?:ptb\\.|canary\\.)?discord(?:app)?\\.com/api/webhooks/\\d{5,}/[A-Za-z0-9_-]{20,}" },
  { "kind": "discord-token", "re": "\\b[MNO][A-Za-z0-9_-]{23,27}\\.[A-Za-z0-9_-]{6}\\.[A-Za-z0-9_-]{27,40}(?![A-Za-z0-9_-])", "needClasses": 3},
  { "kind": "bearer", "re": "(\\b[Bb]earer\\s+)[A-Za-z0-9._~+/=-]{12,}", "replace": "$1{R}" },
  { "kind": "basic-auth", "re": "(\\b[Bb]asic\\s+)[A-Za-z0-9+/]{16,}={0,2}", "replace": "$1{R}" },
  { "kind": "url-password", "re": "(\\b[a-z][a-z0-9+.-]*://[^\\s:/@\\\"']*:)[^\\s@/\\\"']{3,}(?=@)", "flags": "i", "replace": "$1{R}" },
  { "kind": "cookie", "re": "(\\b(?:set-)?cookie:[ \\t]*)[^\\r\\n]{6,}", "flags": "i", "replace": "$1{R}" },
  { "kind": "auth-header", "re": "(\\b(?:proxy-)?authorization[ \\t]*[:=][ \\t]*(?:[A-Za-z]+[ \\t]+)?)(?![\\\"'$<{(\\[])([A-Za-z0-9._~+/=-]{12,})", "flags": "i", "replace": "$1{R}", "needClasses": 2, "codeSafe": true },
  { "kind": "auth-header", "re": "(\\bx-[\\w-]*(?:api-?key|token|secret|auth|signature|session)[\\w-]*[ \\t]*:[ \\t]*)(?![\\\"'$<{(\\[])([A-Za-z0-9._~+/=-]{12,})", "flags": "i", "replace": "$1{R}", "codeSafe": true },
  { "kind": "assignment", "re": "(\\b[\\w.-]*(?:password|passwd|passphrase|pwd|secret|token|api[_-]?key|apikey|access[_-]?key|private[_-]?key|client[_-]?secret|credentials?|auth[_-]?key|session[_-]?id)[\\w.-]*[\"']?[ \\t]*[:=][ \\t]*)([\"'])(?!\\$\\{|<|\\{\\{|\\*{3})([^\"'\\s]{6,})\\2", "flags": "i", "replace": "$1$2{R}$2" },
  { "kind": "assignment", "re": "((?:^|[\\s;,(\\[{?&])(?:export[ \\t]+)?[\\w.-]*(?:password|passwd|passphrase|pwd|secret|token|api[_-]?key|apikey|access[_-]?key|private[_-]?key|client[_-]?secret|credentials?|auth[_-]?key|session[_-]?id)[\\w.-]*=)(?![\"'$<{(*])([^\\s\"'$(){}<>;,&|]{6,})(?![\\w(])", "flags": "im", "replace": "$1{R}", "codeSafe": true },
  { "kind": "assignment", "re": "(^[ \\t]*(?:[-*][ \\t]+)?[\"']?[\\w.-]*(?:password|passwd|passphrase|pwd|secret|token|api[_-]?key|apikey|access[_-]?key|private[_-]?key|client[_-]?secret|credentials?|auth[_-]?key|session[_-]?id)[\\w.-]*[\"']?[ \\t]*:[ \\t]*)(?![\"'$<{(*\\[|>&!%@`])(?!(?:str|string|int|integer|bool|boolean|number|none|null|nil|true|false|undefined|optional|any|object|bytes|text|required)\\b)([^\\s\"']{5,}[^\\s\"',;])(?=[ \\t]*$)", "flags": "im", "replace": "$1{R}", "codeSafe": true },
  { "kind": "assignment", "re": "((?:^|[\\s,{(;])[\"']?[\\w.-]*(?:password|passwd|passphrase|pwd|secret|token|api[_-]?key|apikey|access[_-]?key|private[_-]?key|client[_-]?secret|credentials?|auth[_-]?key|session[_-]?id)[\\w.-]*[\"']?[ \\t]*:[ \\t]*)(?![\"'$<{(*\\[|>&!%@`])([^\\s\"',;(){}\\[\\]<>]{8,})(?=[\\s,;)}\\]]|$)", "flags": "im", "replace": "$1{R}", "needClasses": 2, "codeSafe": true },
  { "kind": "cli-secret", "re": "((?:^|[\\s;|&(])--?[\\w-]*(?:password|passwd|passphrase|token|secret|api-?key|access-?key|client-?secret)[\\w-]*(?:[ \\t]+|=))(?![-\"'$<{(/.~*\\[])([^\\s\"'$(){}<>;,&|]{6,})", "flags": "im", "replace": "$1{R}", "needClasses": 2, "codeSafe": true },
  { "kind": "hex-token", "re": "(?<![A-Za-z0-9_-])[A-Fa-f0-9]{48,}(?![A-Za-z0-9_])", "notAfter": "(?:sha1|sha256|sha384|sha512|md5)[:=-]\\s*$|@sha256:$|(?:checksum|hash|digest|etag|integrity|commit|revision|rev|oid|sha\\w*|md5\\w*)[\\\"']?\\s*[:=]\\s*[\\\"']?$" },
  { "kind": "high-entropy", "re": "(?<![A-Za-z0-9+/_=-])(?!sha(?:1|256|384|512)-)[A-Za-z0-9+/_-]{40,}={0,2}(?![A-Za-z0-9+/_=-])", "minEntropy": 4.5, "needClasses": 3, "notAfter": "(?:sha1|sha256|sha384|sha512)[:=-]$|data:[\\w/+.-]+;base64,$" }
 ]
}
